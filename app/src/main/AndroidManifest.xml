<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Add permission -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="com.huawei.wearengine.permission.DEVICE_MANAGER" />

    <!-- Foreground service: keeps the app process at FG_SERVICE importance (125)
         so Wear Engine continues to function while the user is in another app
         or the screen is off. dataSync is auto-granted and has no extra
         runtime preconditions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep CPU running while the FG service holds a partial wake lock so
         the 5s send loop ticks even when the screen is off and the device
         is unplugged. Without this, Doze + App Standby suspend our process
         between ticks. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets us prompt the user to whitelist us from battery optimization
         (Doze / App Standby). Required for our use case ("peripheral device
         companion app") to keep network access while screen-off + unplugged. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WearEngineAndroidLiteFileMessageSender"
        tools:targetApi="31">

        <!--   please change this value with your wear engine apply appid-->
        <meta-data
            android:name="com.huawei.hms.client.appid"
            android:value="your_wearengine_apply_appid" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WearEngineAndroidLiteFileMessageSender">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchLinkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

    <queries>
        <package android:name="com.huawei.health" />
    </queries>

</manifest>